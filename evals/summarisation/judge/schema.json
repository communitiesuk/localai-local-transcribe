{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SummarisationEvaluation",
  "description": "LLM judge output for an AI-generated meeting summary. Aligned with AIILG-457 HLD v1.0.",
  "type": "object",
  "required": ["summary_id", "transcript_ref", "evaluated_at", "overall_score", "dimensions"],
  "additionalProperties": false,
  "properties": {
    "summary_id":     { "type": "string" },
    "transcript_ref": { "type": "string" },
    "evaluated_at":   { "type": "string", "format": "date-time" },
    "overall_score":  { "type": "number", "minimum": 1, "maximum": 5,
                        "description": "Mean of all eight dimension scores, 1 d.p. For trend analysis only." },
    "dimensions": {
      "type": "object",
      "required": [
        "accuracy", "numerical_accuracy", "template_fit", "coverage",
        "action_clarity", "professional_tone", "readability", "auditability"
      ],
      "additionalProperties": false,
      "properties": {
        "accuracy":           { "$ref": "#/$defs/DimensionResult" },
        "numerical_accuracy": { "$ref": "#/$defs/DimensionResult" },
        "template_fit":       { "$ref": "#/$defs/DimensionResult" },
        "coverage":           { "$ref": "#/$defs/DimensionResult" },
        "action_clarity":     { "$ref": "#/$defs/DimensionResult" },
        "professional_tone":  { "$ref": "#/$defs/DimensionResult" },
        "readability":        { "$ref": "#/$defs/DimensionResult" },
        "auditability":       { "$ref": "#/$defs/DimensionResult" }
      }
    }
  },
  "$defs": {
    "DimensionResult": {
      "type": "object",
      "required": ["score", "rationale", "evidence"],
      "additionalProperties": false,
      "properties": {
        "score":     { "type": "integer", "minimum": 1, "maximum": 5 },
        "rationale": { "type": "string", "minLength": 20,
                       "description": "How evidence maps to rubric criteria." },
        "evidence":  { "type": "array", "minItems": 1,
                       "items": { "type": "string" },
                       "description": "Short quotes or pointers from summary/transcript." }
      }
    }
  }
}
