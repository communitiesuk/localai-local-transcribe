# Copy to .env in this directory (gitignored) and fill in. Kept out of the root .env because docker compose passes
# that whole file into the app containers, API key shouldn't go there.
# POSTGRES_* for --environment local are read from the root .env (or the shell).

PLAUSIBLE_BASE_URL=https://<plausible-host>  #https://plausible.io
PLAUSIBLE_SITE_ID=<site domain>
PLAUSIBLE_API_KEY=<stats api key>
