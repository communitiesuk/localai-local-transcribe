# Copy to terraform.tfvars in this directory. Do not commit terraform.tfvars.
# Replace every placeholder before planning. The real prefixes stay in terraform.tfvars on test ADAPT. They can also be found on SharePoint.

subscription_id     = "<azure-subscription-id>"
resource_group_name = "<resource-group-name>"
location            = "uksouth"
environment_name    = "test"
address_space       = ["<virtual-network-prefix>"]
subnet_prefix       = "<subnet-prefix>"

# Connector hosts, and the vmss-shared prefix until that pool is shut down.
# The ado-vmss-latest subnet 10.170.128.0/25 is added in nsg.tf, so it does not go in this list.
allowed_caller_address_prefixes = ["<caller-prefix>"]

private_endpoint_address_prefixes = {
  state     = "<state-endpoint-prefix>"
  results   = "<results-endpoint-prefix>"
  sensitive = "<sensitive-endpoint-prefix>"
  vault     = "<vault-endpoint-prefix>"
}
