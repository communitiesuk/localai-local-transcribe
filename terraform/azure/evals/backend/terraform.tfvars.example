# Example variable values for bootstrapping Terraform remote state in Softwire sandbox.
# Copy to terraform.tfvars in this directory before applying.
# Optional vars (account_replication_type, soft_delete_retention_days, sas_expiration_period)
# have defaults and may be omitted.

subscription_id      = "00000000-0000-0000-0000-000000000000"
resource_group_name  = "rg-evals-sandbox"
location             = "uksouth"
storage_account_name = "ltevalstfsandbox001"
environment_name     = "sandbox"
