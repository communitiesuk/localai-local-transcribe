# Example values for both evals Terraform roots.
# Copy to terraform.tfvars in this directory; do not commit real subscription IDs, IPs, or object IDs.
# Each root ignores the values belonging to the other and warns about them; use -compact-warnings.

subscription_id     = "<azure-subscription-id>"
resource_group_name = "<resource-group-name>"
location            = "<azure-region>"
environment_name    = "<environment-name>"

terraform_state_storage_account_name = "<terraform-state-storage-account-name>"
sensitive_storage_account_name       = "<sensitive-storage-account-name>"
results_storage_account_name         = "<results-storage-account-name>"

# Azure DevOps pipeline identity.
# pipeline_identity_name = "evals-blob-id"
# ado_federation_issuer  = "https://vstoken.dev.azure.com/<org-guid>"
# ado_federation_subject = "sc://<org>/<project>/evals-blob"

# Network access.
adapt_ip_rules = [
  "<adapt-egress-ip-or-cidr>",
]

mhclg_ip_rules = [
  "<mhclg-egress-ip-or-cidr>",
]

# ado_ip_rules = []
# network_rules_bypass = []

# TODO(AIILG-649): Confirm once the private endpoint setup is known in the Azure environment.
# sensitive_public_network_access_enabled = false

# Private endpoint.
# private_endpoint_subnet_id            = "/subscriptions/.../virtualNetworks/vnet-adapt/subnets/snet-adapt"
# private_endpoint_vnet_id              = "/subscriptions/.../virtualNetworks/vnet-adapt"
# private_endpoint_is_manual_connection = false
# private_dns_zone_ids                  = ["/subscriptions/.../privateDnsZones/privatelink.blob.core.windows.net"]

# Team RBAC.
# TODO(AIILG-649): Spike what we can do via Entra groups to make these less hardcoded.
# input_writer_principal_ids   = ["00000000-0000-0000-0000-000000000000"]
# debug_reader_principal_ids   = ["00000000-0000-0000-0000-000000000000"]
# results_reader_principal_ids = ["00000000-0000-0000-0000-000000000000"]
