#For a full list of backend/worker settings and their description, see common/settings.py

DOCKER_BUILDER_CONTAINER=minute
APP_NAME=minute
ENVIRONMENT=local
APP_URL=http://localhost:3000
BACKEND_HOST=http://localhost:8080

# === AWS ===
AWS_ACCOUNT_ID=placeholder
AWS_REGION=eu-west-2
DATA_S3_BUCKET=i-dot-ai-dev-minute-data

# We get these using aws-vault, docker compose picks them up from the environment variables
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_SESSION_TOKEN=placeholder

# === Azure LLM config ===
AZURE_OPENAI_API_KEY=placeholder
AZURE_OPENAI_ENDPOINT=placeholder
AZURE_DEPLOYMENT=placeholder
AZURE_API_VERSION=placeholder

# === Azure APIM LLM config ===
AZURE_APIM_URL=https://{{host}}.gov.uk/{{product_name}}/
AZURE_APIM_API_VERSION=2024-10-21
AZURE_APIM_ACCESS_TOKEN=placeholder
AZURE_APIM_SUBSCRIPTION_KEY=placeholder
AZURE_APIM_AUTH_METHOD=static_token
AZURE_APIM_TENANT_ID=not_needed_for_static_token
AZURE_APIM_CLIENT_ID=not_needed_for_static_token
AZURE_APIM_CLIENT_SECRET=not_needed_for_static_token
AZURE_APIM_SCOPE=not_needed_for_static_token

# === select transcription services ===
TRANSCRIPTION_SERVICES=["azure_stt_synchronous","azure_stt_batch"]

# === Azure transcription config (APIM) ===
AZURE_BLOB_CONNECTION_STRING=used by azure batch transcription to store results
AZURE_TRANSCRIPTION_CONTAINER_NAME=name of container to store azure transcription results

# === Google cloud ===
GOOGLE_CLOUD_PROJECT=placeholder
GOOGLE_CLOUD_LOCATION=placeholder
GOOGLE_APPLICATION_CREDENTIALS=/app/config/google-credentials.json
# Base64 encoded json of the above. only used in docker container
GOOGLE_APPLICATION_CREDENTIALS_BASE64=placeholder


# === postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=minute_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=insecure

# === queue service ===
TRANSCRIPTION_QUEUE_NAME=minute-transcription-queue
TRANSCRIPTION_DEADLETTER_QUEUE_NAME=minute-transcription-queue-deadletter
LLM_QUEUE_NAME=minute-llm-queue
LLM_DEADLETTER_QUEUE_NAME=minute-llm-queue-deadletter

# === other ===
SENTRY_DSN=
POSTHOG_API_KEY=placeholder

# Only ever set to true in local environments
DISABLE_AUTH_SIGNATURE_VERIFICATION=true
